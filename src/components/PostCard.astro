---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface FilterData {
	category: string;
	title: string;
	excerpt: string;
	tags: string;
}

export interface PostCardProps {
	href: string;
	image: ImageMetadata;
	imageAlt: string;
	tag: string;
	title: string;
	excerpt?: string;
	date?: string;
	/** Machineleesbare datum (YYYY-MM-DD) voor het datetime-attribuut van <time>. */
	dateTime?: string;
	readingTime?: string;
	filter?: FilterData;
}

type Props = PostCardProps;

const { href, image, imageAlt, tag, title, excerpt, date, dateTime, readingTime, filter } = Astro.props;
---

<article
	class="post-card"
	data-category={filter?.category}
	data-title={filter?.title}
	data-excerpt={filter?.excerpt}
	data-tags={filter?.tags}
>
	<a class="post-card-img" href={href}>
		<Image src={image} alt={imageAlt} loading="lazy" width={640} height={400} />
	</a>
	<div class="post-card-body">
		<span class="tag">{tag}</span>
		<h3><a href={href}>{title}</a></h3>
		{excerpt && <p>{excerpt}</p>}
		{
			(date || readingTime) && (
				<div class="post-card-meta">
					{date && <time datetime={dateTime}>{date}</time>}
					{date && readingTime && <span>&middot;</span>}
					{readingTime && <span>{readingTime}</span>}
				</div>
			)
		}
	</div>
</article>
