---
import { services } from '../data/services';
import { dienstenDropdownHref, primaryNav, navCta } from '../data/navigation';
import { business } from '../data/business';
---

<ul class="nav-links" id="navLinks">
	<li class="has-dropdown">
		<a href={dienstenDropdownHref} class="dropdown-trigger">
			Diensten
			<svg class="chevron-icon" viewBox="0 0 10 6" aria-hidden="true"><polyline points="1 1 5 5 9 1"></polyline></svg>
		</a>
		<ul class="dropdown">
			{
				services.map((service) => (
					<li>
						<a href={service.path}>{service.navLabel}</a>
					</li>
				))
			}
		</ul>
	</li>

	{
		primaryNav.map((item) => (
			<li>
				<a href={item.href}>{item.label}</a>
			</li>
		))
	}

	<li>
		<a href={business.phoneHref} class="nav-phone">{business.phoneDisplay}</a>
	</li>
	<li><a href={navCta.href} class="nav-cta">{navCta.label}</a></li>
</ul>
