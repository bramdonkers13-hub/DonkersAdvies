---
import { business } from '../data/business';

interface Props {
	title: string;
	description: string;
	buttonLabel: string;
	buttonHref: string;
}

const { title, description, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-bar">
	<div class="container">
		<h2>{title}</h2>
		<p>{description}</p>
		<a href={buttonHref} class="btn btn-primary">{buttonLabel}</a>
		<p class="cta-phone">
			Of bel direct: <a href={business.phoneHref}>{business.phoneDisplay}</a>
		</p>
		<slot />
	</div>
</section>
