---
import { business } from '../data/business';
---

<div class="contact-form" data-fade>
	<!--
		action/method staan bewust ingevuld: valt het script hieronder uit, dan post de browser
		rechtstreeks naar Formspree in plaats van een GET naar de eigen pagina te doen (waarbij de
		ingevulde gegevens in de URL zouden belanden en de aanvraag verloren gaat).
	-->
	<form
		id="contactForm"
		action={business.formspreeEndpoint}
		method="post"
		data-formspree-endpoint={business.formspreeEndpoint}
		data-redirect="/bedankt/"
	>
		<input type="hidden" name="_subject" value={`Nieuwe aanvraag via ${business.url.replace('https://www.', '')}`} />
		<input type="hidden" name="_next" value={`${business.url}/bedankt/`} />
		<!-- Bronvermelding voor de eigenaar: vanaf welke pagina de aanvraag komt. Gevuld door het script hieronder. -->
		<input type="hidden" name="pagina" id="formPagina" />
		<input type="hidden" name="vorige_pagina" id="formVorigePagina" />
		<!-- Spamval van Formspree: bots vullen dit veld, mensen zien het niet. -->
		<p class="form-gotcha" aria-hidden="true">
			<label for="bedrijfsnaam">Laat dit veld leeg</label>
			<input type="text" id="bedrijfsnaam" name="_gotcha" tabindex="-1" autocomplete="off" />
		</p>
		<div class="form-row-2">
			<div class="form-row">
				<label for="naam">Naam</label>
				<input type="text" id="naam" name="naam" placeholder="Uw naam" autocomplete="name" required />
			</div>
			<div class="form-row">
				<label for="email">E-mailadres</label>
				<input type="email" id="email" name="email" placeholder="uw@email.nl" autocomplete="email" required />
			</div>
		</div>
		<div class="form-row-2">
			<div class="form-row">
				<label for="gemeente">Gemeente of plaats</label>
				<input type="text" id="gemeente" name="gemeente" placeholder="Bijvoorbeeld Wijchen" autocomplete="address-level2" />
			</div>
			<div class="form-row">
				<label for="telefoon">Telefoonnummer (optioneel)</label>
				<input type="tel" id="telefoon" name="telefoon" placeholder="06 12 34 56 78" autocomplete="tel" />
			</div>
		</div>
		<div class="form-row">
			<label for="dienst">Dienst</label>
			<!-- data-path: de dienst wordt voorgeselecteerd als de bezoeker van die dienstpagina komt. -->
			<select id="dienst" name="dienst">
				<option value="">Selecteer een dienst</option>
				<option data-path="/principeverzoek/">Principeverzoek</option>
				<option data-path="/omgevingsplanactiviteit/">OPA – Omgevingsplanactiviteit</option>
				<option data-path="/buitenplanse-omgevingsplanactiviteit/">BOPA – Buitenplanse omgevingsplanactiviteit</option>
				<option data-path="/ruimtelijke-onderbouwing/">Ruimtelijke onderbouwing</option>
				<option data-path="/wijziging-omgevingsplan/">WOP – Wijziging omgevingsplan</option>
				<option>Overig / Algemeen advies</option>
			</select>
		</div>
		<div class="form-row">
			<label for="bericht">Uw initiatief</label>
			<textarea
				id="bericht"
				name="bericht"
				placeholder="Beschrijf uw initiatief. Denk bijvoorbeeld aan de locatie, de gewenste ontwikkeling en waar u tegenaan loopt."
				required></textarea>
		</div>
		<button type="submit" class="btn-submit">
			<span class="btn-submit-text">Vraag een vrijblijvend adviesgesprek aan</span>
			<svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
		</button>
		<p class="form-status" id="formStatus" role="status" aria-live="polite" hidden>
			Het verzenden is niet gelukt. Probeer het opnieuw, of mail rechtstreeks naar
			<a href={`mailto:${business.email}`}>{business.email}</a> of bel <a href={business.phoneHref}>{business.phoneDisplay}</a>.
		</p>
	</form>
	<p class="contact-form-note">
		U ontvangt binnen één werkdag een reactie. In een eerste gesprek bespreken we of uw plan kansrijk is. Daar zijn
		geen kosten aan verbonden. Uw gegevens gebruikt Donkers Advies alleen om uw aanvraag te beantwoorden, zoals
		beschreven in de <a href="/privacy/">privacyverklaring</a>.
	</p>
</div>

<script>
	const form = document.getElementById('contactForm') as HTMLFormElement | null;
	if (form) {
		// Bron van de aanvraag: de huidige pagina en, als de bezoeker van een andere pagina op deze
		// site kwam (bijvoorbeeld via een "neem contact op"-knop), die vorige pagina. Er wordt niets
		// opgeslagen; de referrer wordt alleen op het moment zelf uitgelezen.
		const pagina = document.getElementById('formPagina') as HTMLInputElement | null;
		const vorigePagina = document.getElementById('formVorigePagina') as HTMLInputElement | null;
		if (pagina) pagina.value = window.location.pathname;
		let vorigPad = '';
		try {
			const ref = document.referrer ? new URL(document.referrer) : null;
			if (ref && ref.origin === window.location.origin) vorigPad = ref.pathname;
			if (vorigePagina) vorigePagina.value = ref ? (vorigPad || ref.hostname) : 'direct';
		} catch {
			// Ongeldige referrer: veld blijft leeg.
		}
		const dienst = form.querySelector<HTMLSelectElement>('#dienst');
		const match = dienst?.querySelector<HTMLOptionElement>(`option[data-path="${vorigPad}"]`);
		if (dienst && match && !dienst.value) match.selected = true;

		const endpoint = form.dataset.formspreeEndpoint!;
		const redirect = form.dataset.redirect!;
		const status = document.getElementById('formStatus');
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
			const btnText = btn.querySelector('.btn-submit-text');
			const setText = (text: string) => {
				if (btnText) btnText.textContent = text;
				else btn.textContent = text;
			};
			const fail = () => {
				setText('Verzenden mislukt, probeer opnieuw');
				if (status) status.hidden = false;
				btn.disabled = false;
			};
			setText('Verzenden…');
			if (status) status.hidden = true;
			btn.disabled = true;
			try {
				const res = await fetch(endpoint, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				if (res.ok) {
					window.location.href = redirect;
				} else {
					fail();
				}
			} catch {
				fail();
			}
		});
	}
</script>
