---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoBox from '../components/InfoBox.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StepList from '../components/StepList.astro';
import CompareGrid from '../components/CompareGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { serviceSchema } from '../lib/schema';

const title = 'Principeverzoek opstellen en indienen | Donkers Advies';
const description =
	'Toets de haalbaarheid van uw bouwplan of functiewijziging vooraf bij de gemeente. Donkers Advies stelt uw principeverzoek op en begeleidt het volledige traject.';

const service = serviceSchema({
	name: 'Principeverzoek opstellen en indienen',
	description:
		'Professionele begeleiding bij het opstellen en indienen van een principeverzoek bij de gemeente — van haalbaarheidsanalyse en strategisch advies tot volledige procedurebegeleiding onder de Omgevingswet.',
	path: '/principeverzoek/',
});

const werkwijzeSteps = [
	{
		number: '01',
		title: 'Haalbaarheidsanalyse',
		descriptionHtml:
			"Wij beoordelen uw initiatief aan de hand van het geldende omgevingsplan en relevante beleidsregels. We brengen kansen, risico's en aandachtspunten in kaart — zodat u weet waar u aan toe bent.",
	},
	{
		number: '02',
		title: 'Strategisch advies',
		descriptionHtml:
			'Op basis van de analyse adviseren wij over de optimale positionering van uw initiatief en de meest kansrijke insteek richting de gemeente.',
	},
	{
		number: '03',
		title: 'Opstellen principeverzoek',
		descriptionHtml:
			'Wij stellen een helder, overtuigend en volledig onderbouwd principeverzoek op — inclusief ruimtelijke motivering, beleidstoetsing en alle relevante bijlagen.',
	},
	{
		number: '04',
		title: 'Indienen en afstemming met gemeente',
		descriptionHtml:
			'Wij dienen het verzoek in bij de gemeente en onderhouden gedurende de beoordelingsperiode het contact met de behandelend ambtenaar.',
	},
	{
		number: '05',
		title: 'Beoordeling en vervolgadvies',
		descriptionHtml:
			'Wij analyseren de gemeentelijke reactie en adviseren over de meest geschikte vervolgstap: een <a href="/buitenplanse-omgevingsplanactiviteit/">BOPA</a>, <a href="/omgevingsplanactiviteit/">OPA</a> of <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a>.',
	},
];

const faqItems = [
	{
		question: 'Wat is het verschil tussen een principeverzoek en een vooroverleg?',
		answerHtml:
			'<p>Een principeverzoek is een schriftelijk verzoek aan het gemeentebestuur om een formeel standpunt in te nemen over een ruimtelijke ontwikkeling. Een vooroverleg is een informeel ambtelijk gesprek om uw initiatief te bespreken.</p><p>In de praktijk worden beide gecombineerd: Donkers Advies bereidt het vooroverleg strategisch voor én stelt het formele principeverzoek op dat hierop volgt.</p>',
		answerText:
			'Een principeverzoek is een schriftelijk verzoek aan het gemeentebestuur om een formeel standpunt in te nemen over een ruimtelijke ontwikkeling. Een vooroverleg is een informeel ambtelijk gesprek. In de praktijk worden beide gecombineerd: Donkers Advies bereidt het vooroverleg voor én stelt het formele principeverzoek op.',
	},
	{
		question: 'Wat is het verschil tussen een principeverzoek en een BOPA?',
		answerHtml:
			'<p>Een principeverzoek is een <em>informeel, niet-bindend</em> verzoek waarmee u toetst of de gemeente bereid is mee te werken aan uw initiatief. Een <a href="/buitenplanse-omgevingsplanactiviteit/">BOPA (buitenplanse omgevingsplanactiviteit)</a> is een <em>formele omgevingsvergunning</em> voor een activiteit die afwijkt van het omgevingsplan — inclusief volledige ruimtelijke onderbouwing en formele besluitvorming.</p><p>In de meeste trajecten gaat het principeverzoek vooraf aan de BOPA-aanvraag: eerst toetst u de haalbaarheid, dan werkt u het uit in een formele aanvraag.</p>',
		answerText:
			'Een principeverzoek is een informeel, niet-bindend verzoek waarmee u toetst of de gemeente bereid is mee te werken aan uw initiatief. Een BOPA (buitenplanse omgevingsplanactiviteit) is een formele omgevingsvergunning voor een activiteit die afwijkt van het omgevingsplan. In de meeste gevallen gaat het principeverzoek vooraf aan de BOPA-aanvraag.',
	},
	{
		question: 'Is een positief principeverzoek een garantie op een omgevingsvergunning?',
		answerHtml:
			'<p>Nee. Een positief principeverzoek is juridisch niet bindend. Het geeft aan dat de gemeente <em>in principe</em> bereid is medewerking te verlenen, maar de formele vergunningverlening vindt pas plaats na de volledige aanvraagprocedure.</p><p>Een positieve grondhouding verlaagt het risico aanzienlijk, versnelt de vervolgprocedure en vergroot de kans op een succesvolle vergunningverlening — maar biedt geen juridische zekerheid.</p>',
		answerText:
			'Nee. Een positief principeverzoek is juridisch niet bindend. Het geeft aan dat de gemeente in principe bereid is medewerking te verlenen, maar de formele vergunningverlening vindt pas plaats na de volledige aanvraagprocedure. Een positieve grondhouding verlaagt het risico aanzienlijk en versnelt de vervolgprocedure.',
	},
	{
		question: 'Hoe lang duurt een principeverzoek?',
		answerHtml:
			'<p>De behandeltijd door de gemeente bedraagt gemiddeld <strong>4 tot 12 weken</strong>, afhankelijk van de complexiteit van het initiatief en de interne besluitvorming binnen de gemeente. Wanneer het college van B&amp;W formeel moet instemmen, kan de doorlooptijd langer zijn.</p><p>Een zorgvuldig en volledig opgesteld principeverzoek verkort doorgaans de behandelingstijd. Donkers Advies zorgt voor een zo compleet en overtuigend mogelijk dossier.</p>',
		answerText:
			'De behandeltijd door de gemeente bedraagt gemiddeld 4 tot 12 weken, afhankelijk van de complexiteit van het initiatief en de interne besluitvorming binnen de gemeente. Een zorgvuldig en volledig opgesteld principeverzoek verkort doorgaans de behandelingstijd.',
	},
	{
		question: 'Wat kost een principeverzoek?',
		answerHtml:
			'<p>De kosten bestaan uit twee onderdelen: de advieskosten van Donkers Advies voor het opstellen, onderbouwen en begeleiden van het verzoek, en eventuele gemeentelijke leges voor de behandeling.</p><p>De hoogte van de leges verschilt per gemeente. Donkers Advies geeft u vooraf een helder beeld van de verwachte kosten. <a href="/#contact">Neem contact op voor een vrijblijvende kostenestimatie.</a></p>',
		answerText:
			'De kosten bestaan uit twee onderdelen: de advieskosten van Donkers Advies voor het opstellen, onderbouwen en begeleiden van het verzoek, en eventuele gemeentelijke leges voor de behandeling. De hoogte van de leges verschilt per gemeente. Neem contact op voor een vrijblijvende indicatie.',
	},
	{
		question: 'Wat als de gemeente een negatieve grondhouding heeft?',
		answerHtml:
			'<p>Een negatieve reactie geeft in elk geval dúidelijkheid — en dat heeft waarde. Op basis van de gemeentelijke motivering adviseert Donkers Advies over de mogelijkheden: aanpassing van het plan, een andere locatiekeuze of een strategisch overleg met een hogere bestuurslaag.</p><p>Soms is een negatieve grondhouding niet definitief. Door het plan te herzien of aanvullende informatie aan te leveren kan de gemeente worden overtuigd haar standpunt te heroverwegen. Lees <a href="/blog/principeverzoek-afgewezen/">wat te doen bij een afwijzing</a> voor de volledige uitwerking.</p>',
		answerText:
			'Een negatieve reactie geeft duidelijkheid en heeft waarde. Op basis van de gemeentelijke motivering adviseert Donkers Advies over mogelijkheden: aanpassing van het plan, andere locatiekeuze of een aanvullend strategisch overleg. Soms is een negatieve grondhouding niet definitief.',
	},
];
---

<BaseLayout title={title} description={description} path="/principeverzoek/" jsonLd={[service]}>
	<PageHero
		breadcrumbs={[
			{ name: 'Home', path: '/' },
			{ name: 'Diensten', path: '/#diensten' },
			{ name: 'Principeverzoek', path: '/principeverzoek/' },
		]}
		title="Principeverzoek"
		subtitle="Toets de planologische haalbaarheid van uw initiatief vóór u investeert in onderzoeken of verdere planvorming — Donkers Advies begeleidt uw principeverzoek van analyse tot gemeentebeoordeling."
	/>

	<section class="sp-section bg-white">
		<div class="container">
			<div class="intro-grid">
				<div class="intro-text" data-fade>
					<p class="label">Wat is het</p>
					<h2>Wat is een principeverzoek?</h2>
					<p>
						Een principeverzoek is een informeel verzoek aan de gemeente om vooraf een standpunt in te nemen over
						een voorgenomen ruimtelijke ontwikkeling. Denk aan het realiseren van een woning buiten het
						bouwvlak, een bedrijfsuitbreiding, een functiewijziging van agrarisch naar wonen of een nieuwe
						stedelijke ontwikkeling.
					</p>
					<p>
						De gemeente beoordeelt uw initiatief op hoofdlijnen aan de hand van het geldende omgevingsplan,
						provinciaal beleid en gemeentelijk beleid. Zij geeft vervolgens aan of zij in principe bereid is
						medewerking te verlenen aan verdere planvorming.
					</p>
					<p>
						Hoewel het principeverzoek juridisch niet bindend is, vormt een positieve gemeentelijke grondhouding
						in de praktijk de onmisbare basis voor een formele procedure: een
						<a href="/buitenplanse-omgevingsplanactiviteit/">buitenplanse omgevingsplanactiviteit (BOPA)</a>, een
						<a href="/omgevingsplanactiviteit/">omgevingsplanactiviteit (OPA)</a> of een
						<a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a>.
					</p>
					<p>
						Donkers Advies stelt uw principeverzoek op, verzorgt de ruimtelijke onderbouwing, begeleidt de
						afstemming met de gemeente en adviseert over de strategie die uw initiatief de grootste kans op
						succes geeft.
					</p>
				</div>

				<InfoBox
					fade
					title="Voordelen van een principeverzoek"
					items={[
						'Duidelijkheid over planologische haalbaarheid vóór grote investeringen',
						'Inzicht in het gemeentelijk en provinciaal beleid dat op uw plan van toepassing is',
						'Verkenning van bestuurlijk draagvlak in een vroeg stadium',
						'Lagere kosten dan direct een formele omgevingsvergunning aanvragen zonder zekerheid',
						'Versnelling van de vervolgprocedure (<a href="/buitenplanse-omgevingsplanactiviteit/">BOPA</a> of <a href="/wijziging-omgevingsplan/">wijziging omgevingsplan</a>)',
						'Inzicht in de randvoorwaarden waaronder de gemeente medewerking wil verlenen',
					]}
				/>
			</div>
		</div>
	</section>

	<section class="sp-section bg-paper">
		<div class="container">
			<div data-fade>
				<p class="label">Toepassingsgebied</p>
				<h2>Wanneer is een principeverzoek verstandig?</h2>
				<p>Een principeverzoek onder de Omgevingswet is met name zinvol in de volgende situaties.</p>
			</div>

			<FeatureGrid
				items={[
					{
						title: 'Initiatief buiten het omgevingsplan',
						descriptionHtml:
							'Uw bouwplan of functiewijziging past niet (volledig) binnen het geldende omgevingsplan en vereist planologische medewerking van de gemeente.',
					},
					{
						title: 'Beleidsmatige onzekerheid',
						descriptionHtml:
							'Er bestaat onduidelijkheid over het gemeentelijk, provinciaal of nationaal beleid dat van toepassing is op uw ruimtelijke ontwikkeling.',
					},
					{
						title: 'Afstemming vóór grote investeringen',
						descriptionHtml:
							'U wilt bestuurlijk draagvlak verkennen voordat u kosten maakt voor onderzoeken, architectentekeningen of verdere planvorming.',
					},
					{
						title: 'Ruimtelijke impact op de omgeving',
						descriptionHtml:
							'Uw initiatief heeft mogelijk gevolgen voor de directe omgeving, het landschap of de leefomgeving van omwonenden.',
					},
					{
						title: 'Bestuurlijk draagvlak peilen',
						descriptionHtml:
							'U wilt al in een vroeg stadium weten of het gemeentebestuur openstaat voor uw ruimtelijke ontwikkeling voordat u een formele aanvraag indient.',
					},
					{
						title: 'Voorbereiding op formele procedure',
						descriptionHtml:
							'Het principeverzoek vormt de brug tussen uw idee en een formele procedure: een <a href="/buitenplanse-omgevingsplanactiviteit/">BOPA</a>, <a href="/omgevingsplanactiviteit/">OPA</a> of <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a>.',
					},
				]}
			/>
		</div>
	</section>

	<section class="sp-section bg-forest">
		<div class="container">
			<div data-fade>
				<p class="label">Werkwijze</p>
				<h2 style="color:var(--white); margin-bottom: 2.5rem;">Hoe begeleidt Donkers Advies uw principeverzoek?</h2>
			</div>

			<div class="grid-2" style="align-items:start;">
				<StepList items={werkwijzeSteps} variant="vertical" dark />

				<div data-fade>
					<InfoBox
						style="margin-bottom: 1.25rem;"
						title="Mogelijke reacties van de gemeente"
						items={[
							'<strong style="color:var(--sage-lt);">Positieve grondhouding</strong> — gemeente staat open voor het initiatief, veelal onder randvoorwaarden',
							'<strong style="color:var(--sage-lt);">Voorwaardelijke medewerking</strong> — aanpassing van het plan of aanvullende onderzoeken vereist',
							'<strong style="color:var(--sage-lt);">Negatieve grondhouding</strong> — gemeente ziet geen mogelijkheden binnen huidig beleid',
						]}
					/>
					<InfoBox
						title="Doorlooptijd en kosten"
						items={[
							'Gemeentelijke behandeltijd: gemiddeld <strong style="color:var(--sage-lt);">4 tot 12 weken</strong>',
							'Afhankelijk van complexiteit en interne gemeentelijke afstemming',
							'Sommige gemeenten rekenen leges voor de behandeling van een principeverzoek',
							'Donkers Advies geeft u vooraf inzicht in de verwachte kosten en doorlooptijd',
						]}
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="sp-section bg-sand">
		<div class="container">
			<div data-fade>
				<p class="label">Vervolgstappen</p>
				<h2>Van principeverzoek naar omgevingsvergunning</h2>
				<p style="margin-bottom: 2rem;">
					Na een positief principeverzoek werkt u het initiatief uit in een formele procedure. De meest
					passende route is afhankelijk van uw specifieke situatie.
				</p>
			</div>
			<CompareGrid
				items={[
					{
						title: 'OPA',
						descriptionHtml:
							'Omgevingsvergunning voor een activiteit die <em>past binnen</em> het omgevingsplan, maar waarvoor formele toestemming vereist is.',
						linkLabel: 'Meer over de OPA-procedure',
						linkHref: '/omgevingsplanactiviteit/',
					},
					{
						title: 'BOPA',
						descriptionHtml:
							'Omgevingsvergunning voor een activiteit die <em>afwijkt</em> van het omgevingsplan. Vereist een volledige ruimtelijke onderbouwing.',
						linkLabel: 'Meer over de BOPA-procedure',
						linkHref: '/buitenplanse-omgevingsplanactiviteit/',
						highlight: true,
					},
					{
						title: 'Wijziging omgevingsplan',
						descriptionHtml:
							'Structurele aanpassing van het omgevingsplan — geschikt voor grootschalige of structurele ontwikkelingen.',
						linkLabel: 'Meer over wijziging omgevingsplan',
						linkHref: '/wijziging-omgevingsplan/',
					},
				]}
			/>
		</div>
	</section>

	<section class="sp-section bg-white">
		<div class="container">
			<div data-fade>
				<p class="label">Veelgestelde vragen</p>
				<h2>Veelgestelde vragen over het principeverzoek</h2>
				<p>
					Hieronder vindt u antwoord op de meest gestelde vragen over het principeverzoek onder de Omgevingswet.
					Lees ook <a href="/blog/principeverzoek-indienen/">het complete stappenplan voor het principeverzoek</a> voor een uitgebreide toelichting per stap.
				</p>
			</div>
			<FAQ items={faqItems} />
		</div>
	</section>

	<CTA
		title="Wilt u weten of uw plan haalbaar is?"
		description="Donkers Advies beoordeelt uw initiatief en stelt uw principeverzoek professioneel op. Neem vrijblijvend contact op voor een eerste gesprek over de mogelijkheden."
		buttonLabel="Vraag een vrijblijvend adviesgesprek aan"
		buttonHref="/#contact"
	/>
</BaseLayout>
