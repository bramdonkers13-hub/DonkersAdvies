---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import StepList from '../components/StepList.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { business } from '../data/business';
import heroImage from '../assets/images/hero-buitengebied.jpg';

const title = 'Donkers Advies | Ruimtelijk adviesbureau Omgevingswet';
const description =
	'Ruimtelijk adviesbureau gespecialiseerd in de Omgevingswet. Donkers Advies begeleidt principeverzoeken, OPA, BOPA en wijzigingen van het omgevingsplan.';

const optimizedHero = await getImage({ src: heroImage, width: 1920, format: 'webp', quality: 80 });

const werkwijzeSteps = [
	{
		number: '01',
		title: 'Kennismaking',
		descriptionHtml: 'Bespreken van uw initiatief, de locatie en de gewenste ontwikkeling.',
	},
	{
		number: '02',
		title: 'Haalbaarheidsanalyse',
		descriptionHtml: 'Toetsing aan omgevingsplan, gemeentelijk- en provinciaal beleid.',
	},
	{
		number: '03',
		title: 'Strategisch advies',
		descriptionHtml: 'Advies over de passende procedure.',
	},
	{
		number: '04',
		title: 'Onderbouwing',
		descriptionHtml: 'Ruimtelijke onderbouwing, planregels en onderzoeken.',
	},
	{
		number: '05',
		title: 'Besluitvorming',
		descriptionHtml: 'Begeleiding tot het definitieve besluit, inclusief bezwaar en beroep.',
	},
];

const faqItems = [
	{
		question: 'Wat doet Donkers Advies?',
		answerHtml:
			'<p>Donkers Advies is een ruimtelijk adviesbureau gespecialiseerd in de Omgevingswet. Wij begeleiden particulieren, ondernemers en projectontwikkelaars bij alle planologische procedures: van <a href="/principeverzoek/">principeverzoek</a> en <a href="/omgevingsplanactiviteit/">OPA</a> tot <a href="/buitenplanse-omgevingsplanactiviteit/">BOPA</a> en <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a>. Van eerste haalbaarheidsanalyse tot definitieve vergunningverlening.</p>',
		answerText:
			'Donkers Advies is een ruimtelijk adviesbureau gespecialiseerd in de Omgevingswet. Wij begeleiden particulieren, ondernemers en projectontwikkelaars bij principeverzoeken, omgevingsvergunningen (OPA en BOPA) en wijzigingen van het omgevingsplan. Van eerste haalbaarheidsanalyse tot definitieve vergunningverlening.',
	},
	{
		question: 'Wanneer heb ik een principeverzoek nodig?',
		answerHtml:
			'<p>Een <a href="/principeverzoek/">principeverzoek</a> is verstandig wanneer u wilt weten of uw initiatief planologisch haalbaar is vóórdat u investeert in een formele procedure. De gemeente geeft een niet-bindende reactie op uw plan. Als de gemeente positief staat tegenover uw initiatief, verhoogt dat de kans op een succesvolle formele aanvraag aanzienlijk. Donkers Advies stelt het principeverzoek op en regelt de afstemming met de gemeente.</p>',
		answerText:
			'Een principeverzoek is verstandig wanneer u wilt weten of uw initiatief planologisch haalbaar is voordat u investeert in een formele procedure. Donkers Advies adviseert u over de kansen en stelt het principeverzoek op.',
	},
	{
		question: "In welke regio's is Donkers Advies actief?",
		answerHtml:
			'<p>Donkers Advies is actief in Noord-Brabant, Gelderland en Limburg. Voor initiatieven buiten deze regio\'s kunt u contact opnemen om te bespreken of begeleiding mogelijk is. <a href="#contact">Neem vrijblijvend contact op.</a></p>',
		answerText:
			"Donkers Advies is actief in Noord-Brabant, Gelderland en Limburg. Voor initiatieven buiten deze regio's kunt u contact opnemen om te bespreken of begeleiding mogelijk is.",
	},
	{
		question: 'Hoe lang duurt een planologische procedure?',
		answerHtml:
			'<p>De doorlooptijd hangt af van de procedure:</p><p><strong>Principeverzoek:</strong> 4 tot 12 weken (niet formeel gebonden aan termijnen).</p><p><strong>OPA of BOPA via de reguliere procedure:</strong> maximaal 14 weken.</p><p><strong>BOPA via de uitgebreide procedure:</strong> maximaal 32 weken.</p><p><strong>Wijziging omgevingsplan:</strong> gemiddeld 1 tot 2 jaar, afhankelijk van complexiteit en bestuurlijk draagvlak.</p>',
		answerText:
			'De doorlooptijd hangt af van de procedure. Een principeverzoek duurt doorgaans 4 tot 12 weken. Een OPA of BOPA via de reguliere procedure duurt maximaal 14 weken. Een BOPA via de uitgebreide procedure duurt maximaal 32 weken. Een wijziging van het omgevingsplan duurt gemiddeld 1 tot 2 jaar.',
	},
	{
		question: 'Wat kost begeleiding door Donkers Advies?',
		answerHtml:
			'<p>De kosten zijn afhankelijk van de aard van het initiatief, de benodigde procedure en de complexiteit van de onderbouwing. Donkers Advies geeft u altijd vooraf een helder beeld van de verwachte kosten, inclusief eventuele gemeentelijke leges en onderzoekskosten. <a href="#contact">Neem contact op voor een vrijblijvende indicatie.</a></p>',
		answerText:
			'De kosten zijn afhankelijk van de aard van het initiatief, de benodigde procedure en de complexiteit van de onderbouwing. Donkers Advies geeft u altijd vooraf een helder beeld van de verwachte kosten. Neem contact op voor een vrijblijvende indicatie.',
	},
];
---

<BaseLayout
	title={title}
	description={description}
	path="/"
	jsonLd={[organizationSchema(), websiteSchema()]}
	preloadImage={optimizedHero.src}
>
	<Hero label={`${business.name} — ${business.tagline}`} backgroundImage={optimizedHero.src}>
		<h1>Van initiatief<br /><em>tot vergunning</em></h1>
		<p class="hero-lead">
			Een extra woning, bedrijfsuitbreiding of functiewijziging? Donkers Advies helpt u uw plan ruimtelijk mogelijk te maken en begeleidt u van eerste idee tot vergunning.
		</p>
		<div class="hero-actions">
			<a href="#contact" class="btn btn-primary btn-expand">
				Bespreek uw plan
				<span class="btn-expand-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg></span>
			</a>
			<a href="#diensten" class="btn btn-outline btn-expand">
				Bekijk onze diensten
				<span class="btn-expand-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg></span>
			</a>
		</div>
	</Hero>

	<section id="diensten" class="section">
		<div class="container">
			<div class="section-header" data-fade>
				<p class="label">Dienstverlening</p>
				<h2>Ruimtelijk advies onder de Omgevingswet</h2>
				<p>
					Past uw initiatief niet binnen het geldende omgevingsplan? Of weet u niet welke procedure nodig is om uw plannen mogelijk te maken? Donkers Advies analyseert uw situatie en begeleidt u bij de meest passende ruimtelijke procedure. Ontdek hieronder welke route het beste aansluit bij uw initiatief.
				</p>
			</div>
			<ServiceTabs />
		</div>
	</section>

	<section id="werkwijze" class="section">
		<div class="container">
			<div class="section-header" data-fade>
				<p class="label">Onze aanpak</p>
				<h2>Van initiatief tot vergunning</h2>
				<p style="color: rgba(255,255,255,.7);">
					Een ruimtelijk traject bestaat uit meerdere stappen. Donkers Advies begeleidt het volledige proces: van het eerste idee tot de definitieve besluitvorming door de gemeente.
				</p>
			</div>
			<StepList items={werkwijzeSteps} variant="horizontal" />
		</div>
	</section>

	<section id="voor-wie" class="section">
		<div class="container">
			<div class="section-header" data-fade>
				<h2>Voor wie werkt Donkers Advies?</h2>
				<p>
					Donkers Advies begeleidt particulieren en ondernemers bij uiteenlopende ruimtelijke ontwikkelingen, zoals woningbouw, verbouw, bedrijfsuitbreiding en functiewijziging. Hieronder vindt u enkele voorbeelden.
				</p>
			</div>

			<div class="voor-wie-grid">
				<div class="voor-wie-card" data-fade>
					<div class="vw-label">Particulieren</div>
					<h3>Wonen, bouwen en verbouwen</h3>
					<ul>
						<li>Een extra woning bouwen op uw perceel</li>
						<li>Woningsplitsing of het toevoegen van een woning</li>
						<li>Een woning uitbreiden of een bijgebouw realiseren</li>
						<li>Een agrarische of andere locatie veranderen naar wonen</li>
						<li>Een mantelzorgwoning of andere woonfunctie realiseren</li>
					</ul>
				</div>

				<div class="voor-wie-card" data-fade>
					<div class="vw-label">Ondernemers</div>
					<h3>Bedrijf uitbreiden of functie veranderen</h3>
					<ul>
						<li>Bedrijfsuitbreiding op een bestaande locatie</li>
						<li>Functiewijziging van agrarisch naar bedrijvigheid of wonen</li>
						<li>Herontwikkeling van leegstaand vastgoed</li>
						<li>Eén- of meerdere woningen toevoegen</li>
						<li>Een agrarische of bedrijfslocatie veranderen naar wonen</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="waarom" class="section">
		<div class="container">
			<div class="section-header" data-fade>
				<p class="label">Waarom Donkers Advies</p>
				<h2>Waarom initiatiefnemers voor ons kiezen</h2>
			</div>
			<div class="why-grid">
				<div class="why-card" data-fade>
					<h3>Specialist in ruimtelijke ordening</h3>
					<p>Kennis van de Omgevingswet, het omgevingsplan en de procedures die nodig zijn om uw plan mogelijk te maken.</p>
				</div>
				<div class="why-card" data-fade>
					<h3>Ervaring met gemeentelijke besluitvorming</h3>
					<p>Wij weten hoe gemeenten plannen beoordelen en welke stappen nodig zijn om tot een goed onderbouwd besluit te komen.</p>
				</div>
				<div class="why-card" data-fade>
					<h3>Eén vast aanspreekpunt</h3>
					<p>U heeft gedurende het hele traject direct contact met dezelfde adviseur. Dat zorgt voor korte lijnen en duidelijke communicatie.</p>
				</div>
				<div class="why-card" data-fade>
					<h3>Maatwerk voor uw initiatief</h3>
					<p>Geen standaardaanpak. Wij kijken naar uw plan, locatie en situatie en bepalen samen met u de meest passende aanpak.</p>
				</div>
				<div class="why-card" data-fade>
					<h3>Duidelijk en transparant</h3>
					<p>Geen onnodig vakjargon, maar begrijpelijk advies. U weet waar u aan toe bent en wat u van ons kunt verwachten.</p>
				</div>
				<div class="why-card" data-fade>
					<h3>Van idee tot besluit</h3>
					<p>Van de eerste haalbaarheidsanalyse tot en met de vergunning of het definitieve besluit. Wij begeleiden het volledige traject.</p>
				</div>
			</div>
		</div>
	</section>

	<section id="about" class="section">
		<div class="container">
			<div class="grid-2">
				<div class="about-text" data-fade>
					<p class="label">Over Donkers Advies</p>
					<h2>Specialist in ruimtelijke ordening</h2>
					<p>
						Donkers Advies is een ruimtelijk adviesbureau gespecialiseerd in de Omgevingswet. Wij begeleiden particulieren, ondernemers en projectontwikkelaars bij alle planologische procedures.
					</p>
					<p>
						Dankzij ervaring binnen de gemeentelijke praktijk krijgt u snel inzicht in de planologische mogelijkheden en de kans van slagen van uw initiatief.
					</p>
					<a href="#contact" class="btn btn-forest btn-expand">
						Plan een kennismaking
						<span class="btn-expand-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg></span>
					</a>
				</div>

				<div class="about-grid" data-fade>
					<div class="about-card">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
						<h3>Specialist Omgevingswet</h3>
						<p>Omgevingsplan, ETFAL-toetsing en procedures.</p>
					</div>
					<div class="about-card">
						<svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 21 8 3 8"></polygon><line x1="5" y1="21" x2="5" y2="10"></line><line x1="9" y1="21" x2="9" y2="10"></line><line x1="15" y1="21" x2="15" y2="10"></line><line x1="19" y1="21" x2="19" y2="10"></line><line x1="3" y1="21" x2="21" y2="21"></line></svg>
						<h3>Gemeentelijke ervaring</h3>
						<p>Inzicht in beoordeling en draagvlak.</p>
					</div>
					<div class="about-card">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
						<h3>Eén aanspreekpunt</h3>
						<p>Eén adviseur van begin tot eind.</p>
					</div>
					<div class="about-card">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
						<h3>Heldere communicatie</h3>
						<p>Geen jargon, transparant over kosten.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="faq" class="section">
		<div class="container">
			<div class="section-header" data-fade>
				<p class="label">Veelgestelde vragen</p>
				<h2>Vragen over ruimtelijke ordening en de Omgevingswet</h2>
				<p>
					Hieronder vindt u antwoord op veelgestelde vragen over planologische procedures, de Omgevingswet en de
					dienstverlening van Donkers Advies. Meer weten? Bekijk onze <a href="/blog/">blog</a> voor uitgebreide
					artikelen per procedure.
				</p>
			</div>
			<FAQ items={faqItems} />
		</div>
	</section>

	<section id="contact" class="section">
		<div class="container">
			<div class="contact-inner">
				<div class="contact-text" data-fade>
					<p class="label">Contact</p>
					<h2>Bespreek uw initiatief</h2>
					<p>
						Wilt u weten of uw plan haalbaar is of welke procedure u nodig heeft? Neem vrijblijvend contact op. U ontvangt binnen één werkdag een reactie.
					</p>

					<a href={`mailto:${business.email}`} class="contact-card">
						<div class="contact-card-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
						</div>
						<div>
							<span class="contact-card-label">E-mail</span>
							<span class="contact-card-value">{business.email}</span>
						</div>
					</a>

					<a href={business.phoneHref} class="contact-card">
						<div class="contact-card-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.28h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.91 6.91l.76-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
						</div>
						<div>
							<span class="contact-card-label">Telefoon</span>
							<span class="contact-card-value">{business.phoneDisplay}</span>
						</div>
					</a>

					<div class="contact-card">
						<div class="contact-card-icon">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
						</div>
						<div>
							<span class="contact-card-label">Werkgebied</span>
							<strong class="contact-card-value">{business.areaServed.join(' · ')}</strong>
						</div>
					</div>
				</div>

				<ContactForm />
			</div>
		</div>
	</section>
</BaseLayout>
