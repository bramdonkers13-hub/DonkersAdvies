---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoBox from '../components/InfoBox.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StepList from '../components/StepList.astro';
import CompareGrid from '../components/CompareGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { serviceSchema } from '../lib/schema';

const title = 'BOPA aanvragen | Buitenplanse omgevingsplanactiviteit';
const description =
	'Wijkt uw initiatief af van het omgevingsplan? Donkers Advies stelt de ruimtelijke onderbouwing op en begeleidt uw volledige BOPA-procedure van A tot Z.';

const service = serviceSchema({
	name: 'Buitenplanse omgevingsplanactiviteit (BOPA)',
	description:
		'Professionele begeleiding bij het opstellen van een ruimtelijke onderbouwing en het aanvragen van een omgevingsvergunning voor een buitenplanse omgevingsplanactiviteit (BOPA) onder de Omgevingswet.',
	path: '/buitenplanse-omgevingsplanactiviteit/',
});

const werkwijzeSteps = [
	{
		number: '01',
		title: 'Haalbaarheidsanalyse',
		descriptionHtml:
			"Wij toetsen uw initiatief op hoofdlijnen aan het omgevingsplan, het provinciaal beleid en de gemeentelijke beleidskaders. We brengen de kansen, risico's en aandachtspunten in kaart.",
	},
	{
		number: '02',
		title: 'Strategisch advies en principeverzoek',
		descriptionHtml:
			'Wij adviseren over de meest geschikte route. Indien wenselijk dienen wij eerst een <a href="/principeverzoek/">principeverzoek</a> in om bestuurlijk draagvlak te verkennen voordat u investeert in een volledige onderbouwing.',
	},
	{
		number: '03',
		title: 'Opstellen ruimtelijke onderbouwing',
		descriptionHtml:
			'Wij verzorgen een volledige, juridisch houdbare ruimtelijke onderbouwing met ETFAL-motivering, beleidstoetsing en alle benodigde bijlagen. Wij coördineren de sectorale onderzoeken.',
	},
	{
		number: '04',
		title: 'Indienen via het Omgevingsloket',
		descriptionHtml:
			'Wij dienen de aanvraag namens u in via het Omgevingsloket en zorgen voor een volledig en correct dossier bij de eerste indiening.',
	},
	{
		number: '05',
		title: 'Begeleiding tot vergunningverlening',
		descriptionHtml:
			'Wij onderhouden contact met de gemeente, beantwoorden aanvullende vragen en begeleiden het proces tot en met de definitieve vergunningverlening.',
	},
];

const faqItems = [
	{
		question: 'Wat is een buitenplanse omgevingsplanactiviteit (BOPA)?',
		answerHtml:
			'<p>Een BOPA is een omgevingsvergunning waarmee een activiteit mogelijk wordt gemaakt die afwijkt van het geldende omgevingsplan.</p><p>De aanvraag moet worden onderbouwd met een ruimtelijke onderbouwing waaruit blijkt dat de activiteit leidt tot een evenwichtige toedeling van functies aan locaties (ETFAL). De gemeente heeft bij de beoordeling aanzienlijke beleidsruimte.</p>',
		answerText:
			'Een BOPA is een omgevingsvergunning waarmee een activiteit mogelijk wordt gemaakt die afwijkt van het geldende omgevingsplan. De aanvraag moet worden gemotiveerd met een ruimtelijke onderbouwing waaruit blijkt dat de activiteit leidt tot een evenwichtige toedeling van functies aan locaties (ETFAL).',
	},
	{
		question: 'Wanneer heb ik een BOPA nodig?',
		answerHtml:
			'<p>U heeft een BOPA nodig wanneer uw initiatief niet past binnen de regels van het geldende omgevingsplan, maar u toch een vergunning wilt aanvragen. Typische situaties zijn:</p><ul><li>Woningbouw buiten het bouwvlak of bebouwingscontour</li><li>Functiewijziging van agrarisch naar wonen of bedrijf</li><li>Uitbreidingen die de maximale maten overschrijden</li><li>Nieuwe functies in het buitengebied</li><li>Herbestemming van leegstaand vastgoed</li></ul>',
		answerText:
			'U heeft een BOPA nodig wanneer uw initiatief niet past binnen de regels van het geldende omgevingsplan, maar u toch wilt doorgaan met de ontwikkeling. Voorbeelden zijn: woningbouw buiten het bouwvlak, een functiewijziging van agrarisch naar wonen of bedrijf, uitbreidingen die de maximale maten overschrijden.',
	},
	{
		question: 'Wat is het verschil tussen een BOPA en een OPA?',
		answerHtml:
			'<p>Het verschil zit in de verhouding tot het omgevingsplan:</p><p><strong>OPA:</strong> uw activiteit past <em>binnen</em> het omgevingsplan en is vergunningplichtig. De gemeente toetst alleen aan de planregels. Geen ruimtelijke onderbouwing nodig.</p><p><strong>BOPA:</strong> uw activiteit wijkt <em>af</em> van het omgevingsplan. Een volledige ruimtelijke onderbouwing met ETFAL-motivering is verplicht. De gemeente heeft meer beoordelingsruimte en de procedure is zwaarder.</p>',
		answerText:
			'Bij een OPA (omgevingsplanactiviteit) past uw activiteit binnen de regels van het omgevingsplan, maar is een formele vergunning nodig. Bij een BOPA wijkt uw activiteit af van het omgevingsplan. Een BOPA vereist altijd een ruimtelijke onderbouwing met ETFAL-motivering en heeft een zwaardere procedure.',
	},
	{
		question: 'Wat is het verschil tussen een BOPA en een wijziging van het omgevingsplan?',
		answerHtml:
			'<p>Een BOPA is een vergunning die een eenmalige, incidentele afwijking van het omgevingsplan mogelijk maakt. Het omgevingsplan zelf wordt niet aangepast.</p><p>Een <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a> past de planregels structureel aan, waardoor de activiteit voortaan planologisch is toegestaan voor iedereen op die locatie. Bij grootschalige of permanente ontwikkelingen is een WOP doorgaans beter passend.</p>',
		answerText:
			'Een BOPA is een vergunning die een eenmalige afwijking van het omgevingsplan mogelijk maakt. Een wijziging van het omgevingsplan past de planregels structureel aan, waardoor de activiteit voortaan planologisch is toegestaan. Bij grootschalige of permanente ontwikkelingen is een wijziging van het omgevingsplan doorgaans beter passend dan een BOPA.',
	},
	{
		question: 'Wat is ETFAL en waarom is het zo belangrijk?',
		answerHtml:
			'<p>ETFAL staat voor <em>evenwichtige toedeling van functies aan locaties</em>. Dit is het centrale beoordelingscriterium voor een BOPA onder de Omgevingswet. Het vervangt het vroegere begrip &ldquo;goede ruimtelijke ordening&rdquo; uit de Wet ruimtelijke ordening.</p><p>De gemeente beoordeelt of de activiteit, met alle betrokken belangen afgewogen, aanvaardbaar is op de betreffende locatie. Dit omvat aspecten als ruimtelijke kwaliteit, veiligheid, gezondheid, milieu en omgevingskwaliteit. Een sterke, goed onderbouwde ETFAL-motivering is bepalend voor de kans van slagen van uw aanvraag.</p>',
		answerText:
			"ETFAL staat voor 'evenwichtige toedeling van functies aan locaties'. Dit is het kerncriterium waaraan een BOPA-aanvraag moet voldoen onder de Omgevingswet. Het vervangt het vroegere begrip 'goede ruimtelijke ordening'. Een sterke onderbouwing van ETFAL is essentieel voor een succesvolle aanvraag.",
	},
	{
		question: 'Hoe lang duurt een BOPA-procedure?',
		answerHtml:
			'<p>Er zijn twee procedures mogelijk:</p><ul><li><strong>Reguliere procedure:</strong> beslistermijn 8 weken, met maximale verlenging van 6 weken. Totaal maximaal 14 weken.</li><li><strong>Uitgebreide procedure:</strong> beslistermijn 26 weken, met maximale verlenging van 6 weken. Totaal maximaal 32 weken. Vereist een ontwerpbesluit met terinzagelegging.</li></ul><p>Welke procedure van toepassing is, hangt af van de aard van de activiteit en eventuele m.e.r.-plicht. Donkers Advies adviseert u hierover aan het begin van het traject.</p>',
		answerText:
			'Bij de reguliere procedure bedraagt de beslistermijn 8 weken, met een mogelijke verlenging van 6 weken (totaal maximaal 14 weken). Bij de uitgebreide procedure is de beslistermijn 26 weken, met een verlenging van maximaal 6 weken (totaal maximaal 32 weken).',
	},
	{
		question: 'Wat kost een BOPA aanvragen?',
		answerHtml:
			'<p>De kosten bestaan uit drie onderdelen:</p><ul><li><strong>Gemeentelijke leges:</strong> bepaald door de gemeente op basis van bouwsom of type activiteit. Varieert sterk per gemeente en project.</li><li><strong>Advieskosten Donkers Advies:</strong> voor haalbaarheidsanalyse, ruimtelijke onderbouwing en procedurebegeleiding. Afhankelijk van complexiteit.</li><li><strong>Onderzoekskosten:</strong> voor sectorale onderzoeken (geluid, bodem, ecologie, etc.). Afhankelijk van de benodigde onderzoeken.</li></ul><p>Donkers Advies geeft u vooraf een helder overzicht van alle te verwachten kosten. <a href="/#contact">Neem contact op voor een vrijblijvende indicatie.</a></p>',
		answerText:
			'De kosten bestaan uit gemeentelijke leges, advieskosten en onderzoekskosten. De leges worden bepaald door de gemeente en zijn afhankelijk van de bouwsom of het type activiteit. Donkers Advies geeft u vooraf een helder beeld van de verwachte kosten.',
	},
	{
		question: 'Welke onderzoeken kunnen nodig zijn voor een BOPA?',
		answerHtml:
			'<p>Dit is sterk afhankelijk van uw initiatief en de locatie. Veelvoorkomende onderzoeken zijn:</p><ul><li>Akoestisch onderzoek (geluid)</li><li>AERIUS-berekening (stikstof)</li><li>Ecologisch onderzoek of quickscan (flora en fauna)</li><li>Verkennend bodemonderzoek</li><li>Watertoets</li><li>Archeologisch bureauonderzoek of veldonderzoek</li><li>Externe veiligheidstoets</li><li>Geuronderzoek</li><li>Verkeerskundige onderbouwing</li></ul><p>Donkers Advies bepaalt samen met u welke onderzoeken nodig zijn en coördineert de uitvoering ervan.</p>',
		answerText:
			'Afhankelijk van uw initiatief en de locatie kunnen de volgende onderzoeken nodig zijn: akoestisch onderzoek, stikstofdepositieberekening (AERIUS), ecologisch onderzoek (flora en fauna), bodemonderzoek, watertoets, archeologisch onderzoek, externe veiligheidstoets, geuronderzoek en een verkeersstudie.',
	},
	{
		question: 'Kan de gemeente een BOPA weigeren?',
		answerHtml:
			'<p>Ja. De gemeente heeft bij een BOPA aanzienlijke beoordelingsruimte. Als zij van oordeel is dat de activiteit niet leidt tot een evenwichtige toedeling van functies aan locaties, of niet past binnen het gemeentelijk of provinciaal beleid, kan zij de vergunning weigeren.</p><p>Anders dan bij een OPA, waarbij de toetsing grotendeels juridisch-technisch is, heeft de gemeente bij een BOPA ruimte voor een eigen belangenafweging. Een sterke onderbouwing en goede afstemming vooraf vergroot de kans van slagen aanzienlijk.</p>',
		answerText:
			'Ja. De gemeente heeft bij een BOPA aanzienlijke beleidsruimte. Als de gemeente van oordeel is dat het initiatief niet leidt tot een evenwichtige toedeling van functies aan locaties (ETFAL), of niet past binnen het gemeentelijk of provinciaal beleid, kan zij de vergunning weigeren.',
	},
	{
		question: 'Is een principeverzoek verplicht voor een BOPA?',
		answerHtml:
			'<p>Een <a href="/principeverzoek/">principeverzoek</a> is niet wettelijk verplicht, maar wordt sterk aanbevolen bij een BOPA. Via een principeverzoek toetst u vooraf of de gemeente bereid is mee te werken aan uw initiatief.</p><p>Dit is waardevol omdat het opstellen van een volledige ruimtelijke onderbouwing en de bijbehorende onderzoeken aanzienlijke kosten met zich meebrengt. Een negatieve grondhouding van de gemeente in een vroeg stadium bespaart u die kosten.</p>',
		answerText:
			'Een principeverzoek is niet wettelijk verplicht, maar wordt sterk aanbevolen. Met een principeverzoek toetst u vooraf of de gemeente bereid is mee te werken aan uw initiatief. Dit bespaart u de kosten van een volledige ruimtelijke onderbouwing als de gemeente al in een vroeg stadium aangeeft geen medewerking te willen verlenen.',
	},
	{
		question: 'Moet ik participatie organiseren voor een BOPA?',
		answerHtml:
			'<p>Participatie is onder de Omgevingswet een belangrijk onderdeel van het aanvraagproces. U bent verplicht bij uw aanvraag aan te geven of en hoe u omwonenden en andere belanghebbenden heeft betrokken bij uw initiatief.</p><p>De gemeente kan aanvullende eisen stellen aan de wijze van participatie. Een goed participatieproces vergroot het draagvlak voor uw initiatief en verkleint de kans op zienswijzen en bezwaren. Donkers Advies adviseert u over een effectief participatieproces.</p>',
		answerText:
			'Participatie is onder de Omgevingswet een belangrijk onderdeel van de procedure. De gemeente kan als voorwaarde stellen dat u omwonenden en andere belanghebbenden betrekt bij uw initiatief voordat u een formele aanvraag indient. Donkers Advies adviseert over het participatieproces.',
	},
	{
		question: 'Wat als mijn BOPA-aanvraag wordt geweigerd?',
		answerHtml:
			'<p>Tegen een weigering kunt u bezwaar maken bij de gemeente, en daarna beroep instellen bij de bestuursrechter (Afdeling bestuursrechtspraak van de Raad van State bij ruimtelijke besluiten).</p><p>In de praktijk is het vaak effectiever om eerst in overleg te treden met de gemeente over de bezwaren en te bezien of aanpassing van het plan tot een positief besluit kan leiden. Donkers Advies adviseert u over de beste vervolgstrategie na een weigering.</p>',
		answerText:
			'Tegen een weigering kunt u bezwaar maken bij de gemeente, en daarna eventueel beroep instellen bij de bestuursrechter. In veel gevallen is het effectiever om eerst in overleg te treden met de gemeente over de bezwaren en te bezien of aanpassing van het plan tot een positief besluit kan leiden.',
	},
	{
		question: 'Wat is het verschil tussen een BOPA en een principeverzoek?',
		answerHtml:
			'<p>Een <a href="/principeverzoek/">principeverzoek</a> is een informeel, niet-bindend verzoek aan de gemeente om een standpunt in te nemen over uw initiatief. Het heeft geen rechtsgevolgen en is bedoeld als toetsing vooraf. Het kost minder dan een volledige BOPA-aanvraag.</p><p>Een BOPA is de formele omgevingsvergunning zelf. Bij een BOPA voor een complex of kostbaar initiatief is het bijna altijd verstandig eerst een principeverzoek in te dienen om de kansen te beoordelen.</p>',
		answerText:
			'Een principeverzoek is een informeel, niet-bindend verzoek aan de gemeente om een standpunt in te nemen over uw initiatief. Het heeft geen rechtsgevolgen en gaat vooraf aan de formele procedure. Een BOPA is de formele omgevingsvergunning zelf. Bij complexe initiatieven is het verstandig eerst een principeverzoek in te dienen.',
	},
	{
		question: 'Wanneer geldt de uitgebreide procedure voor een BOPA?',
		answerHtml:
			'<p>De uitgebreide procedure is verplicht bij:</p><ul><li>Activiteiten aangewezen in bijlage III van de Omgevingsregeling</li><li>M.e.r.-(beoordelings)plichtige activiteiten</li><li>Activiteiten waarvoor de provincie of het Rijk bevoegd gezag is</li></ul><p>De uitgebreide procedure kent een beslistermijn van 26 weken en vereist een ontwerpbesluit dat 6 weken ter inzage wordt gelegd, zodat iedereen een zienswijze kan indienen. Donkers Advies begeleidt ook de terinzagelegging en de afhandeling van zienswijzen.</p>',
		answerText:
			'De uitgebreide procedure is verplicht bij activiteiten die zijn aangewezen in bijlage III van de Omgevingsregeling, bij m.e.r.-(beoordelings)plichtige activiteiten en in bepaalde andere bij wet aangewezen gevallen. De uitgebreide procedure kent een beslistermijn van 26 weken en vereist een ontwerpbesluit dat ter inzage wordt gelegd.',
	},
	{
		question: 'Kan ik een BOPA zonder professionele begeleiding aanvragen?',
		answerHtml:
			'<p>Technisch gezien wel, maar het is zelden verstandig. Een succesvolle BOPA-aanvraag vereist:</p><ul><li>Kennis van het omgevingsplan en het provinciaal beleid</li><li>Een juridisch houdbare ETFAL-motivering</li><li>Inzicht in welke sectorale onderzoeken verplicht zijn</li><li>Ervaring met de eisen van het bevoegd gezag</li><li>Kennis van de formele vereisten van het Omgevingsloket</li></ul><p>Fouten of omissies in de aanvraag leiden tot aanhoudingen, extra kosten en vertraging. Professionele begeleiding vergroot de kans van slagen aanzienlijk en voorkomt kostbare fouten.</p>',
		answerText:
			'Technisch gezien wel, maar het is zelden verstandig. Een BOPA-aanvraag vereist een juridisch houdbare ruimtelijke onderbouwing, kennis van het omgevingsplan en provinciaal beleid, en inzicht in welke sectorale onderzoeken nodig zijn. Fouten of omissies leiden tot aanhoudingen, weigeringen of verlies van kostbare tijd.',
	},
	{
		question: 'Waar vraag ik een BOPA aan?',
		answerHtml:
			'<p>Een BOPA-aanvraag dient u in via het <strong>Omgevingsloket</strong> (omgevingsloket.nl), het officiële digitale loket voor alle aanvragen onder de Omgevingswet. De aanvraag gaat naar de gemeente die bevoegd gezag is voor uw locatie.</p><p>Donkers Advies verzorgt de volledige aanvraag en dient deze namens u in. Zo bent u zeker van een correcte en volledige indiening bij de eerste poging.</p>',
		answerText:
			'Een BOPA-aanvraag dient u in via het Omgevingsloket (omgevingsloket.nl). Dit is het officiële digitale loket voor alle aanvragen onder de Omgevingswet. De aanvraag gaat naar de gemeente die bevoegd gezag is voor uw locatie.',
	},
];
---

<BaseLayout title={title} description={description} path="/buitenplanse-omgevingsplanactiviteit/" jsonLd={[service]}>
	<PageHero
		breadcrumbs={[
			{ name: 'Home', path: '/' },
			{ name: 'Diensten', path: '/#diensten' },
			{ name: 'Buitenplanse omgevingsplanactiviteit (BOPA)', path: '/buitenplanse-omgevingsplanactiviteit/' },
		]}
		title="Buitenplanse omgevingsplanactiviteit (BOPA)"
		subtitle="Uw initiatief past niet binnen het geldende omgevingsplan, maar u wilt toch verder. Donkers Advies stelt de ruimtelijke onderbouwing op en begeleidt uw BOPA-aanvraag van eerste analyse tot vergunningverlening."
	/>

	<section class="sp-section bg-white">
		<div class="container">
			<div class="intro-grid">
				<div class="intro-text" data-fade>
					<p class="label">Wat is het</p>
					<h2>Wat is een buitenplanse omgevingsplanactiviteit (BOPA)?</h2>
					<p>Een BOPA is een omgevingsvergunning waarmee een activiteit mogelijk wordt gemaakt die afwijkt van het geldende omgevingsplan.</p>
					<p>
						Anders dan bij een <a href="/omgevingsplanactiviteit/">omgevingsplanactiviteit (OPA)</a> past uw
						initiatief hier dus <em>niet</em> binnen de bestaande planregels. Toch kan de gemeente toestemming
						verlenen, mits u kunt aantonen dat de activiteit leidt tot een
						<strong>evenwichtige toedeling van functies aan locaties (ETFAL)</strong>.
					</p>
					<p>
						Donkers Advies begeleidt particulieren en ondernemers bij het volledige BOPA-traject: van
						haalbaarheidsanalyse en strategisch advies tot het opstellen van de ruimtelijke onderbouwing en de
						begeleiding van de formele vergunningsprocedure.
					</p>

					<div class="highlight-box">
						<strong>Wat is ETFAL?</strong>
						De <em>evenwichtige toedeling van functies aan locaties</em> is het centrale beoordelingscriterium
						voor een BOPA onder de Omgevingswet. Het vervangt het vroegere begrip &ldquo;goede ruimtelijke
						ordening&rdquo;. De gemeente weegt alle betrokken belangen af en beoordeelt of de activiteit
						aanvaardbaar is op de betreffende locatie. Een sterke ETFAL-motivering is de basis van iedere
						kansrijke BOPA-aanvraag.
					</div>
				</div>

				<InfoBox
					fade
					title="Wanneer is een BOPA nodig?"
					items={[
						'Woningbouw buiten het bouwvlak of buiten de bebouwingscontour',
						'Functiewijziging van agrarisch naar wonen of bedrijf',
						'Uitbreidingen die de maximale maten van het omgevingsplan overschrijden',
						'Afwijkingen van bouwhoogte, oppervlak, rooilijn of gebruiksregels',
						'Herbestemming van leegstaand vastgoed naar een nieuwe functie',
						'Bed &amp; breakfast of recreatieve functies in een woonbestemming',
					]}
				/>
			</div>
		</div>
	</section>

	<section class="sp-section bg-paper">
		<div class="container">
			<div data-fade>
				<p class="label">Toepassingsgebied</p>
				<h2>Wanneer is een BOPA de juiste procedure?</h2>
				<p>Een BOPA is niet altijd de juiste route. De keuze hangt af van uw specifieke situatie, de omvang van uw initiatief en de mate van afwijking van het omgevingsplan.</p>
			</div>

			<FeatureGrid
				items={[
					{
						title: 'Activiteit wijkt af van het omgevingsplan',
						descriptionHtml:
							'Uw bouwplan, functiewijziging of gebruik past niet binnen de geldende planregels. Voor een tijdelijke of incidentele afwijking is een BOPA doorgaans de aangewezen route.',
					},
					{
						title: 'Kleinschalige of incidentele ontwikkeling',
						descriptionHtml:
							'Gaat het om een beperkte afwijking of een eenmalige ontwikkeling? Dan is een BOPA sneller en goedkoper dan een <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a>.',
					},
					{
						title: 'Activiteit past juist wel binnen het plan → OPA',
						descriptionHtml:
							'Past uw initiatief al binnen het omgevingsplan maar is een vergunning vereist? Dan heeft u geen BOPA maar een <a href="/omgevingsplanactiviteit/">omgevingsplanactiviteit (OPA)</a> nodig.',
					},
					{
						title: 'Grootschalige of permanente ontwikkeling → WOP',
						descriptionHtml:
							'Gaat het om een structurele, grootschalige of herhaaldelijk gewenste ontwikkeling? Een <a href="/wijziging-omgevingsplan/">wijziging van het omgevingsplan</a> is dan juridisch robuuster.',
					},
					{
						title: 'Twijfel over haalbaarheid → eerst principeverzoek',
						descriptionHtml:
							'Weet u niet of de gemeente wil meewerken? Begin dan met een <a href="/principeverzoek/">principeverzoek</a>. Dat bespaart u de kosten van een ruimtelijke onderbouwing als haalbaarheid onzeker is.',
					},
					{
						title: 'Activiteit is vergunningvrij → geen procedure nodig',
						descriptionHtml:
							'Valt uw initiatief onder vergunningvrij bouwen? Dan heeft u helemaal geen vergunning nodig. Donkers Advies toetst snel of dat het geval is.',
					},
				]}
			/>
		</div>
	</section>

	<section class="sp-section bg-white">
		<div class="container">
			<div data-fade>
