---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import InfoBox from '../components/InfoBox.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StepList from '../components/StepList.astro';
import CompareGrid from '../components/CompareGrid.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { serviceSchema } from '../lib/schema';

const title = 'BOPA aanvragen: ruimtelijke onderbouwing en begeleiding';
const description =
	'Wijkt uw plan af van het omgevingsplan? Donkers Advies stelt de onderbouwing op en begeleidt uw BOPA tot vergunning, met kennis van de gemeentelijke praktijk.';

const service = serviceSchema({
	name: 'BOPA aanvragen en ruimtelijke onderbouwing',
	description:
		'Opstellen van de ruimtelijke onderbouwing en volledige begeleiding van een BOPA-aanvraag onder de Omgevingswet.',
	path: '/buitenplanse-omgevingsplanactiviteit/',
});

const waaromItems = [
	{
		title: 'Donkers Advies kent de beoordeling van binnenuit.',
		descriptionHtml:
			'Vanuit de gemeentelijke praktijk zijn BOPA-aanvragen beoordeeld, dus het is bekend waar het college op let. Uw dossier sluit daarop aan.',
	},
	{
		title: 'Eerst de haalbaarheid, dan pas kosten.',
