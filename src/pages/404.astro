---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Pagina niet gevonden — Donkers Advies"
	description="Deze pagina bestaat niet (meer). Ga terug naar de homepage of bekijk onze diensten."
	path="/404/"
	noindex
>
	<section class="section" style="min-height: 60vh; display: flex; align-items: center;">
		<div class="container" style="text-align: center; max-width: 600px; margin-inline: auto;">
			<div data-fade>
				<p class="label" style="text-align:center;">Foutcode 404</p>
				<h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 1rem;">Pagina niet gevonden</h1>
				<p style="max-width: 48ch; margin-inline: auto; margin-bottom: 2.5rem;">
					De pagina die u zoekt bestaat niet of is verplaatst. Ga terug naar de homepage of bekijk onze
					diensten en blog.
				</p>
				<div class="hero-actions" style="justify-content: center;">
					<a href="/" class="btn btn-primary">Terug naar de homepage</a>
					<a href="/blog/" class="btn btn-forest">Bekijk de blog</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
